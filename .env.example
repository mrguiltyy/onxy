# ════════════════════════════════════════════════════════════════
# Onyx Services — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to git.
# ════════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://onyx.gg

# ── Supabase ───────────────────────────────────────────────────
# Project URL: Supabase dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Public anon key — safe to expose to browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxx...

# Service role key — NEVER expose to browser, server-only
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxx...

# ── Stripe ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ── Cloudflare R2 (private tool storage) ───────────────────────
R2_ACCOUNT_ID=xxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxx
R2_BUCKET_NAME=onyx-tools
R2_PUBLIC_URL=https://cdn.onyx.gg

# ── Resend (email) ─────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Onyx Services <noreply@onyx.gg>

# ── Discord (OAuth + webhooks) ─────────────────────────────────
DISCORD_CLIENT_ID=xxxxxxxxxxxx
DISCORD_CLIENT_SECRET=xxxxxxxxxxxx
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxxxxxx
DISCORD_GUILD_ID=xxxxxxxxxxxx

# ── License Server (separate Node service) ─────────────────────
LICENSE_SERVER_URL=https://license.onyx.gg
LICENSE_SERVER_INTERNAL_SECRET=xxxxxxxxxxxx

# ── IP geolocation / VPN detection ─────────────────────────────
IPDATA_API_KEY=xxxxxxxxxxxx

# ── Misc ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
